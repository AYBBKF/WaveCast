 "groups": [
  {
   "text": "قد تصلك الحرب…",
   "start": 0.0,
   "end": 0.94,
   "n": 3
  },
  {
   "text": "دون قصف.",
   "start": 0.94,
   "end": 1.98,
   "n": 2
  },
  {
   "text": "كيف؟ تخيّل حرباً",
   "start": 1.98,
   "end": 3.24,
   "n": 3
  },
  {
   "text": "عالمية ثالثة.",
   "start": 3.24,
   "end": 4.64,
   "n": 2
  },
  {
   "text": "هذا سيناريو افتراضي،",
   "start": 4.64,
   "end": 5.98,
   "n": 3
  },
  {
   "text": "وليس خبراً عن حرب بدأت.",
   "start": 5.98,
   "end": 7.96,
   "n": 5
  },
  {
   "text": "العالم شبكة:",
   "start": 7.96,
   "end": 9.2,
   "n": 2
  },
  {
   "text": "سفن تحمل الغذاء،",
   "start": 9.2,
   "end": 10.68,
   "n": 3
  },
  {
   "text": "ووقود يشغّل النقل،",
   "start": 10.68,
   "end": 12.3,
   "n": 3
  },
  {
   "text": "ومصانع تعتمد على شحنات",
   "start": 12.3,
   "end": 14.26,
   "n": 4
  },
  {
   "text": "من دول أخرى.",
   "start": 14.26,
   "end": 15.54,
   "n": 3
  },
  {
   "text": "إذا تعطّلت ممرات الشحن،",
   "start": 15.54,
   "end": 17.26,
   "n": 4
  },
  {
   "text": "فقد تتأخر الإمدادات.",
   "start": 17.26,
   "end": 18.84,
   "n": 3
  },
  {
   "text": "وإذا اضطربت الطاقة،",
   "start": 18.84,
   "end": 20.32,
   "n": 3
  },
  {
   "text": "قد تزيد كلفة النقل والإنتاج.",
   "start": 20.32,
   "end": 22.4,
   "n": 5
  },
  {
   "text": "وقد تظهر النتيجة",
   "start": 22.4,
   "end": 23.9,
   "n": 3
  },
  {
   "text": "على رفّ المتجر،",
   "start": 23.9,
   "end": 24.86,
   "n": 3
  },
  {
   "text": "وفي سعر الخبز.",
   "start": 24.86,
   "end": 26.04,
   "n": 3
  },
  {
   "text": "لكن هناك فرق مهم:",
   "start": 26.04,
   "end": 27.66,
   "n": 4
  },
  {
   "text": "حرب عالمية",
   "start": 27.66,
   "end": 29.1,
   "n": 2
  },
  {
   "text": "لا تعني تلقائياً حرباً نووية.",
   "start": 29.1,
   "end": 31.18,
   "n": 5
  },
  {
   "text": "إذا حدث تصعيد نووي،",
   "start": 31.18,
   "end": 33.06,
   "n": 4
  },
  {
   "text": "فقد يضيف دماراً هائلاً،",
   "start": 33.06,
   "end": 34.76,
   "n": 4
  },
  {
   "text": "وحرارة شديدة، وإشعاعاً،",
   "start": 34.76,
   "end": 37.08,
   "n": 3
  },
  {
   "text": "وآثاراً طويلة الأمد.",
   "start": 37.08,
   "end": 38.76,
   "n": 3
  },
  {
   "text": "إنها إمكانية خطيرة،",
   "start": 38.76,
   "end": 40.68,
   "n": 3
  },
  {
   "text": "وليست مرحلة محتومة.",
   "start": 40.68,
   "end": 42.86,
   "n": 3
  },
  {
   "text": "لهذا لا يوجد",
   "start": 42.86,
   "end": 44.0,
   "n": 3
  },
  {
   "text": "سيناريو واحد مؤكّد،",
   "start": 44.0,
   "end": 45.62,
   "n": 3
  },
  {
   "text": "ولا موعد يمكن الجزم به.",
   "start": 45.62,
   "end": 47.72,
   "n": 5
  },
  {
   "text": "ما قد يحدث",
   "start": 47.72,
   "end": 48.92,
   "n": 3
  },
  {
   "text": "يعتمد على القرارات،",
   "start": 48.92,
   "end": 50.46,
   "n": 3
  },
  {
   "text": "وعلى فرص منع التصعيد.",
   "start": 50.46,
   "end": 52.22,
   "n": 4
  },
  {
   "text": "أحياناً، لا تحتاج الحرب",
   "start": 52.22,
   "end": 54.54,
   "n": 4
  },
  {
   "text": "أن تصل إلى مدينتك…",
   "start": 54.54,
   "end": 56.08,
   "n": 4
  },
  {
   "text": "كي تصل آثارها إلى حياتك.",
   "start": 56.08,
   "end": 60.32,
   "n": 5
  }
 ]
}