 "groups": [
  {
   "text": "أصبحت أغنى رجلٍ في بابل…",
   "start": 0.34,
   "end": 2.34,
   "n": 5
  },
  {
   "text": "لكنني خسرت أول مالٍ جمعته.",
   "start": 2.34,
   "end": 4.86,
   "n": 5
  },
  {
   "text": "كنت ناسخاً أكتب",
   "start": 4.86,
   "end": 5.96,
   "n": 3
  },
  {
   "text": "على ألواح الطين.",
   "start": 5.96,
   "end": 7.3,
   "n": 3
  },
  {
   "text": "أعمل طويلاً،",
   "start": 7.3,
   "end": 8.32,
   "n": 2
  },
  {
   "text": "ثم يذهب أجري للطعام والملابس،",
   "start": 8.32,
   "end": 10.54,
   "n": 5
  },
  {
   "text": "ولا يبقى شيء.",
   "start": 10.54,
   "end": 11.94,
   "n": 3
  },
  {
   "text": "سألت رجلاً ثرياً عن البداية،",
   "start": 11.94,
   "end": 13.9,
   "n": 5
  },
  {
   "text": "فتعلّمت أن أحتفظ",
   "start": 13.9,
   "end": 15.08,
   "n": 3
  },
  {
   "text": "بعُشر ما أكسب.",
   "start": 15.08,
   "end": 16.52,
   "n": 3
  },
  {
   "text": "بدأت أدّخر.",
   "start": 16.52,
   "end": 17.66,
   "n": 2
  },
  {
   "text": "لكنني سلّمت مدخراتي لصانع",
   "start": 17.66,
   "end": 19.68,
   "n": 4
  },
  {
   "text": "طوب كي يشتري جواهر.",
   "start": 19.68,
   "end": 21.96,
   "n": 4
  },
  {
   "text": "عندما عاد،",
   "start": 21.96,
   "end": 22.9,
   "n": 2
  },
  {
   "text": "كانت الجواهر مجرد زجاج!",
   "start": 22.9,
   "end": 25.51,
   "n": 4
  },
  {
   "text": "خسرت المال،",
   "start": 25.68,
   "end": 26.64,
   "n": 2
  },
  {
   "text": "وتعلّمت أن الخبرة في الطوب",
   "start": 26.64,
   "end": 28.18,
   "n": 5
  },
  {
   "text": "لا تعني الخبرة في الجواهر.",
   "start": 28.18,
   "end": 30.12,
   "n": 5
  },
  {
   "text": "بدأت من جديد،",
   "start": 30.12,
   "end": 31.5,
   "n": 3
  },
  {
   "text": "وموّلت صانع دروع يعرف عمله.",
   "start": 31.5,
   "end": 34.08,
   "n": 5
  },
  {
   "text": "ثم تعلّمت أن",
   "start": 34.08,
   "end": 34.88,
   "n": 3
  },
  {
   "text": "أعيد استثمار الأرباح،",
   "start": 34.88,
   "end": 36.38,
   "n": 3
  },
  {
   "text": "بدل إنفاقها كلها.",
   "start": 36.38,
   "end": 38.48,
   "n": 3
  },
  {
   "text": "وبعد سنوات،",
   "start": 38.48,
   "end": 39.5,
   "n": 2
  },
  {
   "text": "اختارني معلّمي شريكاً لإدارة أملاكه،",
   "start": 39.5,
   "end": 42.54,
   "n": 5
  },
  {
   "text": "ثم نلت نصيباً من تركته.",
   "start": 42.54,
   "end": 45.16,
   "n": 5
  },
  {
   "text": "هكذا بدأت ثروتي تكبر؛",
   "start": 45.3,
   "end": 47.46,
   "n": 4
  },
  {
   "text": "بالتعلّم، والصبر، والفرص.",
   "start": 47.46,
   "end": 50.36,
   "n": 3
  },
  {
   "text": "والآن… هل عرفت من أنا؟",
   "start": 50.58,
   "end": 53.48,
   "n": 5
  },
  {
   "text": "اكتب اسمي في التعليقات.",
   "start": 53.48,
   "end": 56.66,
   "n": 4
  }
 ]
}