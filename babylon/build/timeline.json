 "groups": [
  {
   "text": "أصبحت أغنى رجلٍ في بابل…",
   "start": 0.0,
   "end": 2.38,
   "n": 5
  },
  {
   "text": "لكنني خسرت أول مالٍ جمعته.",
   "start": 2.38,
   "end": 4.95,
   "n": 5
  },
  {
   "text": "كنت ناسخاً أكتب",
   "start": 4.95,
   "end": 6.25,
   "n": 3
  },
  {
   "text": "على ألواح الطين.",
   "start": 6.25,
   "end": 8.01,
   "n": 3
  },
  {
   "text": "أعمل طويلاً،",
   "start": 8.01,
   "end": 9.09,
   "n": 2
  },
  {
   "text": "ثم يذهب أجري للطعام والملابس،",
   "start": 9.09,
   "end": 11.66,
   "n": 5
  },
  {
   "text": "ولا يبقى شيء.",
   "start": 11.66,
   "end": 13.24,
   "n": 3
  },
  {
   "text": "سألت رجلاً ثرياً عن البداية،",
   "start": 13.24,
   "end": 15.62,
   "n": 5
  },
  {
   "text": "فتعلّمت أن أحتفظ",
   "start": 15.62,
   "end": 16.98,
   "n": 3
  },
  {
   "text": "بعُشر ما أكسب.",
   "start": 16.98,
   "end": 18.56,
   "n": 3
  },
  {
   "text": "بدأت أدّخر.",
   "start": 18.56,
   "end": 19.82,
   "n": 2
  },
  {
   "text": "لكنني سلّمت مدخراتي لصانع",
   "start": 19.82,
   "end": 21.87,
   "n": 4
  },
  {
   "text": "طوب كي يشتري جواهر.",
   "start": 21.87,
   "end": 23.94,
   "n": 4
  },
  {
   "text": "عندما عاد،",
   "start": 23.94,
   "end": 24.96,
   "n": 2
  },
  {
   "text": "كانت الجواهر مجرد زجاج!",
   "start": 24.96,
   "end": 27.28,
   "n": 4
  },
  {
   "text": "خسرت المال،",
   "start": 27.28,
   "end": 28.36,
   "n": 2
  },
  {
   "text": "وتعلّمت أن الخبرة في الطوب",
   "start": 28.36,
   "end": 30.59,
   "n": 5
  },
  {
   "text": "لا تعني الخبرة في الجواهر.",
   "start": 30.59,
   "end": 33.22,
   "n": 5
  },
  {
   "text": "بدأت من جديد،",
   "start": 33.22,
   "end": 34.54,
   "n": 3
  },
  {
   "text": "وموّلت صانع دروع يعرف عمله.",
   "start": 34.54,
   "end": 37.17,
   "n": 5
  },
  {
   "text": "ثم تعلّمت أن",
   "start": 37.17,
   "end": 38.29,
   "n": 3
  },
  {
   "text": "أعيد استثمار الأرباح،",
   "start": 38.29,
   "end": 40.12,
   "n": 3
  },
  {
   "text": "بدل إنفاقها كلها.",
   "start": 40.12,
   "end": 41.94,
   "n": 3
  },
  {
   "text": "وبعد سنوات،",
   "start": 41.94,
   "end": 43.02,
   "n": 2
  },
  {
   "text": "اختارني معلّمي شريكاً لإدارة أملاكه،",
   "start": 43.02,
   "end": 45.9,
   "n": 5
  },
  {
   "text": "ثم نلت نصيباً من تركته.",
   "start": 45.9,
   "end": 48.28,
   "n": 5
  },
  {
   "text": "هكذا بدأت ثروتي تكبر؛",
   "start": 48.28,
   "end": 50.48,
   "n": 4
  },
  {
   "text": "بالتعلّم، والصبر، والفرص.",
   "start": 50.48,
   "end": 52.91,
   "n": 3
  },
  {
   "text": "والآن… هل عرفت من أنا؟",
   "start": 52.91,
   "end": 55.62,
   "n": 5
  },
  {
   "text": "اكتب اسمي في التعليقات.",
   "start": 55.62,
   "end": 59.39,
   "n": 4
  }
 ]
}