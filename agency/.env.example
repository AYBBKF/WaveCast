# ===================== ChronoShorts — configuration =====================
# Copier en `.env` et remplir. Les variables CHRONO_* sont optionnelles.

# --- Claude (obligatoire) ---
ANTHROPIC_API_KEY=sk-ant-...
# Modèles (identifiants réels ; repli automatique si indisponibles sur le compte)
CHRONO_DIRECTOR_MODEL=claude-opus-5-5
CHRONO_WORKER_MODEL=claude-haiku-5-5
CHRONO_DIRECTOR_EFFORT=high
CHRONO_WORKER_EFFORT=medium
CHRONO_WEB_SEARCH=true

# --- Chaîne ---
CHRONO_CHANNEL_NAME=ChronoShorts
# fr | en | ar
CHRONO_LANGUAGE=fr
CHRONO_TARGET_DURATION_MIN=45
CHRONO_TARGET_DURATION_MAX=60

# --- Voix (une voix cohérente pour toute la chaîne) ---
# elevenlabs | edge (gratuit) | silent (tests)
CHRONO_TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
CHRONO_ELEVENLABS_VOICE_ID=
CHRONO_ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Images et vidéo (Replicate) ---
# replicate | placeholder
CHRONO_IMAGE_PROVIDER=replicate
# replicate | kenburns (composition animée locale, sans API)
CHRONO_VIDEO_PROVIDER=replicate
REPLICATE_API_TOKEN=
CHRONO_REPLICATE_IMAGE_MODEL=black-forest-labs/flux-1.1-pro
# bytedance/seedance-1-pro | kwaivgi/kling-v2.1 | minimax/hailuo-02
CHRONO_REPLICATE_VIDEO_MODEL=bytedance/seedance-1-pro
CHRONO_VIDEO_FALLBACK_KENBURNS=true

# --- Telegram (livraison) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CHRONO_REQUIRE_DIRECTOR_APPROVAL=true

# --- Planification ---
CHRONO_DAILY_VIDEOS=1
CHRONO_SCHEDULE_HOURS=[9]

# --- Chemins ---
CHRONO_WORKDIR=/opt/chronoshorts/productions
CHRONO_ASSETS_DIR=/opt/chronoshorts/assets
