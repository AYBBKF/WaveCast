# Variables à définir chez votre hébergeur (ou à exporter avant de lancer gunicorn). Ne versionnez jamais les vraies valeurs.
ACADEMY_DEBUG=0
ACADEMY_SECRET_KEY=remplacez-par-une-longue-chaine-aleatoire
ACADEMY_BASE_URL=https://academy.fluxintelligent.com
ACADEMY_ALLOWED_HOSTS=academy.fluxintelligent.com
ACADEMY_CSRF_TRUSTED_ORIGINS=https://academy.fluxintelligent.com
DATABASE_URL=postgres://utilisateur:motdepasse@127.0.0.1:5432/academy
ACADEMY_MEDIA_ROOT=/srv/academy/media
ACADEMY_PRIVATE_ROOT=/srv/academy/private
# E-mails (vérification d'adresse, mot de passe oublié)
ACADEMY_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
ACADEMY_EMAIL_HOST=smtp.example.com
ACADEMY_EMAIL_PORT=587
ACADEMY_EMAIL_USER=no-reply@fluxintelligent.com
ACADEMY_EMAIL_PASSWORD=
ACADEMY_EMAIL_TLS=1
ACADEMY_FROM_EMAIL=Flux Intelligent Academy <no-reply@fluxintelligent.com>
